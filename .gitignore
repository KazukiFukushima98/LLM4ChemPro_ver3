# --- Raw run data (kept out of version control by design; see ARCHITECTURE.md) ---
# ルート runs/(旧 run5〜21)と algorithm/runs/(現行)のみを除外する。
# 抽出済みの軽量データ results/runs/ は追跡対象なので、無印の runs/ に戻さないこと。
/runs/
/algorithm/runs/

# --- Scratch (一時利用・確認用・コミット禁止) ---
algorithm/scratch/

# --- Claude Code: local settings は除外、共有コマンドだけ追跡 ---
.claude/*
!.claude/commands/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- uv / virtual env ---
.venv/
venv/

# --- Aspen ---
*.dmp
# YAspen 配下は全部無視し、本体2ファイルだけホワイトリストで追跡
algorithm/src/YAspen/*
!algorithm/src/YAspen/YAspen.apw
!algorithm/src/YAspen/YAspen.bkp
~$*

# --- Reference literature (著作物 PDF。公開リポジトリに含めない) ---
reference/

# --- OS / editor ---
.DS_Store
.idea/
*.swp

# --- Quarto レンダリング生成物(ソースは .qmd。生成物はコミットしない) ---
.quarto/
/paper/paper.html
/paper/paper.tex
/paper/paper_files/
/slides/*.html
/slides/*_files/

# --- Quarto/VS Code プレビューの一時ファイル ---
*.quarto_ipynb
*.quarto_ipynb_*
